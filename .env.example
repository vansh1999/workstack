# Compose-level configuration for `docker compose up`.
# Copy to `.env` (gitignored) and edit before running anything beyond
# local dev. All values below match the current local-dev defaults, so
# `docker compose up` works with no setup at all.

# Postgres
POSTGRES_USER=workstack
POSTGRES_PASSWORD=workstack
POSTGRES_DB=workstack

# Backend
SECRET_KEY=changeme-generate-a-real-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# Host port mappings
BACKEND_PORT=8000
FRONTEND_PORT=5173
